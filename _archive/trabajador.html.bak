<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#e9edf6">
    <title>Mi portal - Portal de Trabajadores</title>
    <link rel="stylesheet" href="styles.css">
</head>

<body>
    <main class="main solo-main page-enter">
        <header class="topbar">
            <div style="display:flex;align-items:center;gap:12px">
                <span class="brand-icon"><span class="icon" data-icon="clock" data-size="20"></span></span>
                <div>
                    <h1>Hola, <span id="user-name">trabajador</span></h1>
                    <p>Registra tu jornada y revisa tus horas y tu pago.</p>
                </div>
            </div>
            <div class="topbar-actions">
                <span class="badge info"><i></i> Trabajador</span>
                <button class="btn btn-sm" id="logout-btn" type="button">
                    <span class="icon" data-icon="logout" data-size="16"></span> Salir
                </button>
            </div>
        </header>

        <div class="stats">
            <article class="stat" style="--i:0">
                <div class="label"><span class="icon-chip"><span class="icon" data-icon="clock" data-size="16"></span></span> Horas totales</div>
                <div class="value" id="stat-horas">0.00 h</div>
                <div class="sub" id="stat-horas-sub">-</div>
            </article>
            <article class="stat" style="--i:1">
                <div class="label"><span class="icon-chip green"><span class="icon" data-icon="wallet" data-size="16"></span></span> Total a cobrar</div>
                <div class="value" id="stat-pago">$0.00</div>
                <div class="sub" id="stat-pago-sub">-</div>
            </article>
            <article class="stat" style="--i:2">
                <div class="label"><span class="icon-chip purple"><span class="icon" data-icon="calendar" data-size="16"></span></span> Jornadas</div>
                <div class="value" id="stat-jornadas">0</div>
                <div class="sub" id="stat-jornadas-sub">-</div>
            </article>
            <article class="stat" style="--i:3">
                <div class="label"><span class="icon-chip green"><span class="icon" data-icon="chart" data-size="16"></span></span> Tu tarifa</div>
                <div class="value" id="stat-tarifa">$0.00</div>
                <div class="sub">por hora trabajada</div>
            </article>
        </div>

        <div class="split">
            <div class="card">
                <div class="card-head">
                    <div>
                        <h2>Registrar jornada</h2>
                        <p>Las horas se calculan al guardar.</p>
                    </div>
                </div>
                <form id="jornada-form" novalidate>
                    <div class="field">
                        <label for="fecha">Fecha</label>
                        <input class="input" id="fecha" type="date" required>
                    </div>
                    <div class="grid-2">
                        <div class="field">
                            <label for="entrada">Hora de entrada</label>
                            <input class="input" id="entrada" type="time" required>
                        </div>
                        <div class="field">
                            <label for="salida">Hora de salida</label>
                            <input class="input" id="salida" type="time" required>
                        </div>
                    </div>
                    <div class="field">
                        <label for="lunch">Lunch (minutos)</label>
                        <input class="input" id="lunch" type="number" min="0" max="600" step="5" value="60">
                    </div>
                    <div class="field">
                        <label for="notas">Notas <span class="muted">(opcional)</span></label>
                        <textarea class="textarea" id="notas" placeholder="Ej. turno nocturno, incidencia..."></textarea>
                    </div>

                    <div class="total-strip">
                        <span class="lbl">Horas efectivas</span>
                        <span class="val" id="preview-horas">0.00 h</span>
                    </div>

                    <button class="btn btn-primary btn-block" id="save-btn" type="submit" style="margin-top:14px">
                        <span class="spinner"></span>
                        <span class="btn-label">Guardar jornada</span>
                        <span class="icon" data-icon="check" data-size="16"></span>
                    </button>
                </form>
            </div>

            <div class="card">
                <div class="card-head">
                    <div>
                        <h2>Mis jornadas</h2>
                        <p id="jornadas-count">-</p>
                    </div>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Entrada</th>
                                <th>Salida</th>
                                <th>Lunch</th>
                                <th>Horas</th>
                                <th>Monto</th>
                                <th>Notas</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="tabla-jornadas"></tbody>
                    </table>
                </div>
                <div class="total-strip">
                    <div>
                        <div class="lbl" id="total-label">0 jornadas</div>
                        <div class="lbl">Horas: <strong id="total-horas">0.00 h</strong></div>
                    </div>
                    <div class="val" id="total-pago">$0.00</div>
                </div>
            </div>
        </div>
    </main>

    <dialog id="confirm-dialog">
        <div class="dialog-body">
            <div class="window-bar">
                <div class="traffic"><i></i><i></i><i></i></div>
                <div class="window-title">Confirmar acción</div>
                <span style="width:52px"></span>
            </div>
            <div class="dialog-content">
                <h3 id="confirm-title">Eliminar jornada</h3>
                <p class="muted" id="confirm-text" style="margin-top:6px;font-size:.85rem">Se borrará este registro de forma permanente.</p>
                <div class="dialog-actions">
                    <button class="btn btn-ghost" id="confirm-cancel" type="button">Cancelar</button>
                    <button class="btn btn-danger" id="confirm-ok" type="button">Eliminar</button>
                </div>
            </div>
        </div>
    </dialog>

    <script type="module">
        import {
            api, bootstrap, money, hours, fmtDate, fmtTime, escapeHtml, calcularHoras,
            requireRole, handleAuthFailure, setLoading, toast, animateNumber, hydrateIcons,
            setSession, todayISO
        } from './app.js';

        await bootstrap();
        let session = requireRole('trabajador', 'index.html', api.secure);

        if (session) {
            let jornadas = [];
            let usuario = session.usuario;

            const form = document.getElementById('jornada-form');
            const fecha = document.getElementById('fecha');
            const entrada = document.getElementById('entrada');
            const salida = document.getElementById('salida');
            const lunch = document.getElementById('lunch');
            const notas = document.getElementById('notas');
            const saveButton = document.getElementById('save-btn');

            fecha.value = todayISO();

            function renderPreview() {
                const value = calcularHoras(entrada.value, salida.value, lunch.value);
                document.getElementById('preview-horas').textContent = hours(value);
            }

            function render() {
                const totalHoras = jornadas.reduce((sum, j) => sum + j.horas_calculadas, 0);
                const tarifa = Number(usuario.tarifa_hora) || 0;
                const tarifaDe = j => Number(j.tarifa_hora) || tarifa;
                const total = jornadas.reduce((sum, j) => sum + j.horas_calculadas * tarifaDe(j), 0);
                const days = new Set(jornadas.map(j => String(j.fecha).slice(0, 10)));

                document.getElementById('user-name').textContent = usuario.nombre || 'trabajador';
                animateNumber(document.getElementById('stat-horas'), totalHoras, hours);
                document.getElementById('stat-horas-sub').textContent = `${days.size} ${days.size === 1 ? 'día registrado' : 'días registrados'}`;
                animateNumber(document.getElementById('stat-pago'), total, money);
                document.getElementById('stat-pago-sub').textContent = `Tarifa actual: ${money(tarifa)}/h`;
                animateNumber(document.getElementById('stat-jornadas'), jornadas.length, value => Math.round(value).toString());
                document.getElementById('stat-jornadas-sub').textContent = 'registros guardados';
                animateNumber(document.getElementById('stat-tarifa'), tarifa, money);

                const tbody = document.getElementById('tabla-jornadas');
                tbody.innerHTML = jornadas.map(j => `
                    <tr>
                        <td class="num">${fmtDate(j.fecha)}</td>
                        <td class="num">${fmtTime(j.hora_entrada)}</td>
                        <td class="num">${fmtTime(j.hora_salida)}</td>
                        <td class="num">${Number(j.minutos_lunch) || 0} min</td>
                        <td class="num">${hours(j.horas_calculadas)}</td>
                        <td class="num"><strong>${money(j.horas_calculadas * tarifaDe(j))}</strong></td>
                        <td class="muted" style="max-width:170px;overflow:hidden;text-overflow:ellipsis" title="${escapeHtml(j.notas || '')}">${escapeHtml(j.notas || '-')}</td>
                        <td>
                            <button class="btn btn-icon btn-ghost" data-delete="${j.id}" aria-label="Eliminar jornada">
                                <span class="icon" data-icon="trash" data-size="16"></span>
                            </button>
                        </td>
                    </tr>
                `).join('') || `<tr><td colspan="8"><div class="empty"><span class="icon" data-icon="calendar" data-size="26"></span>Tu primera jornada aparecerá aquí.</div></td></tr>`;

                document.getElementById('jornadas-count').textContent = jornadas.length ? `${jornadas.length} ${jornadas.length === 1 ? 'registro' : 'registros'}` : 'Sin registros todavía';
                document.getElementById('total-label').textContent = `${jornadas.length} ${jornadas.length === 1 ? 'jornada' : 'jornadas'}`;
                document.getElementById('total-horas').textContent = hours(totalHoras);
                document.getElementById('total-pago').textContent = money(total);
                hydrateIcons(tbody);
            }

            async function load(showToast = false) {
                try {
                    const data = await api.workerData(session);
                    usuario = data.usuario || usuario;
                    jornadas = data.jornadas || [];
                    const refreshed = { ...session, usuario };
                    setSession(refreshed);
                    session = refreshed;
                    render();
                    if (showToast) toast('Datos actualizados.', 'ok');
                } catch (error) {
                    if (handleAuthFailure(error, 'index.html', 'trabajador')) return;
                    toast(error.message, 'err');
                }
            }

            form.addEventListener('submit', async event => {
                event.preventDefault();
                const payload = {
                    fecha: fecha.value,
                    hora_entrada: entrada.value,
                    hora_salida: salida.value,
                    minutos_lunch: Number(lunch.value) || 0,
                    notas: notas.value.trim() || null
                };

                if (!payload.fecha || !payload.hora_entrada || !payload.hora_salida) {
                    toast('Completa fecha, entrada y salida.', 'err');
                    return;
                }
                if (payload.minutos_lunch < 0 || payload.minutos_lunch > 600) {
                    toast('Los minutos de lunch deben estar entre 0 y 600.', 'err');
                    return;
                }

                setLoading(saveButton, true);
                try {
                    await api.createJornada(payload, session);
                    notas.value = '';
                    toast('Jornada guardada.', 'ok');
                    await load();
                } catch (error) {
                    if (handleAuthFailure(error, 'index.html', 'trabajador')) return;
                    toast(error.message, 'err');
                } finally {
                    setLoading(saveButton, false);
                }
            });

            [entrada, salida, lunch].forEach(el => el.addEventListener('input', renderPreview));
            renderPreview();

            document.getElementById('tabla-jornadas').addEventListener('click', async event => {
                const button = event.target.closest('[data-delete]');
                if (!button) return;
                const dialog = document.getElementById('confirm-dialog');
                dialog.showModal();
                const result = await new Promise(resolve => {
                    const ok = document.getElementById('confirm-ok');
                    const cancel = document.getElementById('confirm-cancel');
                    const finish = value => {
                        dialog.close();
                        ok.removeEventListener('click', onOk);
                        cancel.removeEventListener('click', onCancel);
                        resolve(value);
                    };
                    const onOk = () => finish(true);
                    const onCancel = () => finish(false);
                    ok.addEventListener('click', onOk);
                    cancel.addEventListener('click', onCancel);
                    dialog.addEventListener('cancel', () => finish(false), { once: true });
                });
                if (!result) return;
                button.disabled = true;
                try {
                    await api.deleteJornada(button.dataset.delete, session, false);
                    toast('Jornada eliminada.', 'ok');
                    await load();
                } catch (error) {
                    if (handleAuthFailure(error, 'index.html', 'trabajador')) return;
                    toast(error.message, 'err');
                    button.disabled = false;
                }
            });

            document.getElementById('logout-btn').addEventListener('click', async () => {
                await api.logout('trabajador');
                location.replace('index.html');
            });

            hydrateIcons();
            await load();
        }
    </script>
</body>

</html>

